{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "https://cloudflare-dns.com/dns-query",
      "tls://1.1.1.1",
      "1.1.1.1"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "email": "USER",
            "id": "UUID",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "172.20.0.20:443",
          "xver": 2,
          "serverNames": [
            "SERVER"
          ],
          "privateKey": "PVK",
          "shortIds": [
            "ID"
          ],
          "maxTimeDiff": 60000
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ip": [
          "geoip:private",
          "geoip:ru"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-gov-ru"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "domain": [
          "domain:ru",
          "domain:su",
          "domain:ru.com",
          "domain:ru.net",
          "domain:xn--p1ag",
          "domain:xn--p1acf",
          "domain:xn--80aswg",
          "domain:xn--p1ai",
          "domain:xn--80asehdb",
          "domain:xn--j1aef",
          "domain:xn--80adxhks",
          "domain:xn--80aswg",
          "domain:xn--c1avg",
          "domain:xn--d1acj3b"
        ],
        "outboundTag": "block"
      }
    ]
  }
}
